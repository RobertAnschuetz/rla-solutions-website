# Caching rules for Apache (All-Inkl). Netlify ignores this file.
# Without explicit headers, browsers guess a cache lifetime from the file's age
# and can keep showing an outdated page for days after a deploy.

<IfModule mod_headers.c>
  # HTML: always ask the server whether there is a newer version
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  # CSS / JS: short cache, then revalidate (filenames carry ?v= versions in the HTML)
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
  # Images, fonts, icons: cache for a week
  <FilesMatch "\.(jpe?g|png|webp|svg|woff2|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
  # SEO helpers: revalidate
  <FilesMatch "\.(xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# Directory index without extension
DirectoryIndex index.html
